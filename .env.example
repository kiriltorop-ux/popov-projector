DOMAIN=popov.example.org
PUBLIC_URL=https://popov.example.org
DATABASE=work/popov.sqlite3
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=replace-with-deepseek-key
ASR_BASE_URL=https://api.groq.com/openai/v1
ASR_MODEL=whisper-large-v3-turbo
ASR_API_KEY=replace-with-groq-key
TTS_BACKEND=piper
# Character shown by this station (popov or minin).
POPOV_GUIDE=popov
# Optional: TTS_BACKEND=openai, TTS_API_KEY, TTS_BASE_URL, TTS_MODEL
QR_SECRET=replace-with-at-least-32-random-characters
STATION_KEY=replace-with-another-32-random-characters
# To prohibit questions from home even with a freshly shared QR, set the venue's
# public egress IPs/CIDRs (IPv4 AND IPv6 if used). Blank allows any network with QR.
VISITOR_NETWORKS=
# Same-computer mode (setup-local.command):
POPOV_LOCAL_PORT=18776
# POPOV_LAN_HOST=192.168.1.10
# POPOV_LOCAL_PUBLIC_URL=https://trusted-local-host.example.org
